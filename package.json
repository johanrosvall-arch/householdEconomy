{
  "name": "household-economy",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time household spend tracking for Swedish households",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build && pnpm --filter @household/api build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "api": "pnpm --filter @household/api dev",
    "mobile": "pnpm --filter @household/mobile start",
    "web": "pnpm --filter @household/mobile web",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @household/api db:migrate",
    "db:deploy": "pnpm --filter @household/api db:deploy",
    "db:seed": "pnpm --filter @household/api db:seed",
    "db:reset": "pnpm --filter @household/api db:reset"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.6.3",
      "@react-native/metro-config": "0.86.2",
      "@expo/metro-runtime": "~57.0.9",
      "react-native-worklets": "0.10.1",
      "react-native-reanimated": "4.5.1"
    }
  }
}
