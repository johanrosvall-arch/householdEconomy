{
  "expo": {
    "name": "Hushållsekonomi",
    "slug": "household-economy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "householdeconomy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "se.household.economy"
    },
    "android": {
      "package": "se.household.economy",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1"
    }
  }
}
