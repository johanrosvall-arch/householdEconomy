# Copy to .env. Not committed — .env is gitignored.
#
# Must be an address the PHONE can reach. `localhost` is the handset itself,
# so it only works in a simulator on the same machine as the API.
#
#   Same Wi-Fi:  http://192.168.1.42:3000/api/v1     (your machine's LAN IP)
#   Tailscale:   http://100.x.y.z:3000/api/v1        (`tailscale ip -4`)
#
# Restart the Expo dev server after changing this — it is inlined at build time.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
