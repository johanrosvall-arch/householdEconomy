# Copy to .env and fill in. Never commit the real file.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL="postgresql://household:household@localhost:5432/household?schema=public"

# Signs access and refresh tokens. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-at-least-32-characters-of-random"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts stored bank provider tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-to-a-32-byte-base64-key-value-here"

# Comma-separated allowed origins, or * in development.
CORS_ORIGINS=*

# Bank aggregation adapter: 'mock' ships today.
# Adding a real provider is documented in docs/bank-integrations.md.
BANK_PROVIDER=mock

# Deep link the bank returns the user to after BankID consent.
BANK_REDIRECT_URL=householdeconomy://bank-callback

# This API's base URL *as the phone sees it*. The mock bank's consent page is
# served from here, so localhost only works in a simulator. On a real device
# use your LAN or Tailscale address, e.g. http://100.101.102.103:3000
PUBLIC_API_URL=http://localhost:3000

# Credentials for a real aggregator, once you have signed up.
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=

MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
